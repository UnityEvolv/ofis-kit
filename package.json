{
  "name": "ofiskit",
  "private": true,
  "type": "module",
  "description": "The open-source virtual office engine behind unityofis.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnityEvolv/ofis-kit.git"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "server",
    "app"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:packages": "tsc -b packages/template packages/presence-store packages/adapters packages/realtime-core packages/realtime-client packages/ui-map packages/ui-builder",
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm run build:packages && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budget": "node tools/bundle-budget/check.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build:packages && changeset publish",
    "build:pages": "npm run build:packages && npm run --workspace ofiskit-app build:pages",
    "test:a11y": "playwright test --project=a11y",
    "watch:packages": "tsc -b packages/template packages/presence-store packages/adapters packages/realtime-core packages/realtime-client packages/ui-map packages/ui-builder server --watch --preserveWatchOutput",
    "kit:styles": "node tools/kit-styles/check.mjs",
    "no-branding": "node tools/no-branding/check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-ofiskit": "*",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
